From ce8856f2e3a44ca5191b1245e75821c013d707bb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Th=C3=A9ry?= <romain.thery@ik.me>
Date: Thu, 19 Nov 2026 12:09:03 +0100
Subject: [PATCH] Hold a wake lock while a closed tunnel is reported

When the IKE session closes, EpdgTunnelManager and IwlanDataService
pass the close through two handlers before telephony learns that the
PDN is gone. A DPD timeout fires from an alarm, and the device went
back to suspend before the IwlanDataService handler ran: telephony saw
the loss 2 to 5 minutes later, and IMS over Wi-Fi stayed down meanwhile.

Hold a timed partial wake lock from the IKE close callbacks so the close
reaches telephony right away.

Assisted-by: LLM
---
 .../android/iwlan/epdg/EpdgTunnelManager.java | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/com/google/android/iwlan/epdg/EpdgTunnelManager.java b/src/com/google/android/iwlan/epdg/EpdgTunnelManager.java
index 82eeae7..1f5d539 100644
--- a/src/com/google/android/iwlan/epdg/EpdgTunnelManager.java
+++ b/src/com/google/android/iwlan/epdg/EpdgTunnelManager.java
@@ -72,6 +72,7 @@
 import android.os.HandlerThread;
 import android.os.Looper;
 import android.os.Message;
+import android.os.PowerManager;
 import android.support.annotation.IntDef;
 import android.support.annotation.NonNull;
 import android.support.annotation.Nullable;
@@ -120,10 +121,13 @@
 public class EpdgTunnelManager {
     private final FeatureFlags mFeatureFlags;
     private final Context mContext;
+    @Nullable private final PowerManager.WakeLock mTunnelClosedWakeLock;
     private final int mSlotId;
     private Handler mHandler;
     private ConnectivityDiagnosticsCallback mConnectivityDiagnosticsCallback;
 
+    private static final long TUNNEL_CLOSED_WAKE_LOCK_TIMEOUT_MS = 5000;
+
     private static final int EVENT_TUNNEL_BRINGUP_REQUEST = 0;
     private static final int EVENT_TUNNEL_BRINGDOWN_REQUEST = 1;
     private static final int EVENT_CHILD_SESSION_OPENED = 2;
@@ -514,6 +518,7 @@ public void onOpened(IkeSessionConfiguration sessionConfiguration) {
         @Override
         public void onClosed() {
             Log.d(TAG, "Ike session closed for apn: " + mApnName + " with token: " + mToken);
+            holdWakeLockForTunnelClosed();
             mHandler.obtainMessage(
                             EVENT_IKE_SESSION_CLOSED,
                             new SessionClosedData(mApnName, mToken, null /* ikeException */))
@@ -523,6 +528,7 @@ public void onClosed() {
         @Override
         public void onClosedWithException(IkeException exception) {
             mNextReauthId = null;
+            holdWakeLockForTunnelClosed();
             onSessionClosedWithException(exception, mApnName, mToken, EVENT_IKE_SESSION_CLOSED);
         }
 
@@ -720,6 +726,15 @@ private EpdgTunnelManager(Context context, int slotId, FeatureFlags featureFlags
         mFeatureFlags = featureFlags;
         mIkeSessionCreator = ikeSessionCreator;
         mIpSecManager = mContext.getSystemService(IpSecManager.class);
+        PowerManager powerManager = mContext.getSystemService(PowerManager.class);
+        mTunnelClosedWakeLock =
+                powerManager == null
+                        ? null
+                        : powerManager.newWakeLock(
+                                PowerManager.PARTIAL_WAKE_LOCK, "Iwlan:TunnelClosed");
+        if (mTunnelClosedWakeLock != null) {
+            mTunnelClosedWakeLock.setReferenceCounted(false);
+        }
         // Adding this here is necessary because we need to initialize EpdgSelector at the beginning
         // to ensure no broadcasts are missed.
         mEpdgSelector = epdgSelector;
@@ -1893,6 +1908,13 @@ private EapSessionConfig getEapConfig() throws IwlanSimNotReadyException {
                 .build();
     }
 
+    // The close is passed through handlers to telephony, which do not run while suspended.
+    private void holdWakeLockForTunnelClosed() {
+        if (mTunnelClosedWakeLock != null) {
+            mTunnelClosedWakeLock.acquire(TUNNEL_CLOSED_WAKE_LOCK_TIMEOUT_MS);
+        }
+    }
+
