From 1156ef453c5e5599b7b92d30446de06f22ba4107 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Th=C3=A9ry?= <romain.thery@ik.me>
Date: Sat, 14 Nov 2026 21:07:12 +0100
Subject: [PATCH] Settings: Follow Wi-Fi calling being turned off from
 elsewhere

The Wi-Fi calling screen read the setting only when it resumed, so when
the IMS service turned Wi-Fi calling off, for one because the carrier
refused it, the switch stayed on until the screen was reopened. Watch
the setting while the screen is shown and redraw it, without taking the
redraw for the user flipping the switch.

Assisted-by: LLM
Change-Id: I4249b895aa741577e53ed7e76995781994914c86
---
 .../calling/WifiCallingSettingsForSub.java    | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/com/android/settings/wifi/calling/WifiCallingSettingsForSub.java b/src/com/android/settings/wifi/calling/WifiCallingSettingsForSub.java
index 46be70dfddb1..c26f29c6d5bb 100644
--- a/src/com/android/settings/wifi/calling/WifiCallingSettingsForSub.java
+++ b/src/com/android/settings/wifi/calling/WifiCallingSettingsForSub.java
@@ -24,7 +24,10 @@
 import android.content.Intent;
 import android.content.IntentFilter;
 import android.content.res.Resources;
+import android.database.ContentObserver;
 import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
 import android.os.PersistableBundle;
 import android.telephony.CarrierConfigManager;
 import android.telephony.ServiceState;
@@ -112,6 +115,23 @@ public class WifiCallingSettingsForSub extends DashboardFragment
 
     private PhoneTelephonyCallback mTelephonyCallback;
 
+    // The IMS service can turn Wi-Fi calling off by itself, for one when the carrier refuses it.
+    private final ContentObserver mWfcEnabledObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    // Refreshing the switch must not be taken for the user flipping it.
+                    final boolean listening = mTelephonyCallback != null;
+                    if (listening) {
+                        mSwitchBar.removeOnSwitchChangeListener(WifiCallingSettingsForSub.this);
+                    }
+                    updateBody();
+                    if (listening) {
+                        mSwitchBar.addOnSwitchChangeListener(WifiCallingSettingsForSub.this);
+                    }
+                }
+            };
+
     private class PhoneTelephonyCallback extends TelephonyCallback implements
             TelephonyCallback.CallStateListener {
         /*
@@ -438,6 +458,8 @@ public void onResume() {
         }
         context.registerReceiver(mIntentReceiver, mIntentFilter,
                 Context.RECEIVER_EXPORTED_UNAUDITED);
+        context.getContentResolver().registerContentObserver(
+                SubscriptionManager.WFC_ENABLED_CONTENT_URI, true, mWfcEnabledObserver);
         final Intent intent = getActivity().getIntent();
         if (intent.getBooleanExtra(Phone.EXTRA_KEY_ALERT_SHOW, false)) {
             showAlert(intent);
@@ -459,6 +481,7 @@ public void onPause() {
             mSwitchBar.removeOnSwitchChangeListener(this);
         }
         context.unregisterReceiver(mIntentReceiver);
+        context.getContentResolver().unregisterContentObserver(mWfcEnabledObserver);
     }
 
     /**
